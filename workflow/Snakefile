    log:
        str(OUTPUT_ROOT / "logs" / "pre_merge_stats" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    shell:
        """
        (
            echo "Pre-merge assembly statistics for {wildcards.unique_id}" > {output}
            echo "========================================" >> {output}
            echo "" >> {output}
            echo "MetaviralSPADES contigs:" >> {output}
            seqkit stats {input.metaviral} >> {output}
            echo "" >> {output}
            echo "EsViritu contigs:" >> {output}
            seqkit stats {input.esviritu} >> {output}
        ) &> {log}
        """

# =============================================================================
# Module: Hybrid Assembly - Minimap2 Merging
# =============================================================================
rule merge_with_read_support:
    """
    Merge assemblies with read-based validation using clear decision rules.

    Decision priority:
    1. Coverage >2x different -> choose higher coverage
    2. Similar coverage but MAPQ >10 different -> choose higher MAPQ
    3. Similar quality but different length -> choose longer
    """
    input:
        metaviral=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "metaviral_renamed.fasta"),
        esviritu=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "esviritu_renamed.fasta"),
        r1=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R2.fastq"),
    output:
        hybrid=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_hybrid.fasta"),
        report=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_merge_decisions.tsv"),
    log:
        str(OUTPUT_ROOT / "logs" / "merge_read_support" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    threads: MERGE_THREADS  # Reuse same thread allocation
    resources:
        mem_mb=MERGE_MEM_MB,
        partition="cmmr",
    params:
        workdir=lambda wc: str(HYBRID_ROOT / wc.category / wc.unique_id / "hybrid" / "work"),
        min_overlap=MERGE_MIN_OVERLAP,
        min_identity=MERGE_MIN_IDENTITY,
    shell:
        """
        (
            echo "[$(date)] Merging assemblies with read support for {wildcards.unique_id}"

            python scripts/merge_with_reads.py \
                --assembly1 {input.esviritu} \
                --assembly2 {input.metaviral} \
                --reads1 {input.r1} \
                --reads2 {input.r2} \
                --output {output.hybrid} \
                --report {output.report} \
                --threads {threads} \
                --min-overlap {params.min_overlap} \
                --min-identity {params.min_identity} \
                --workdir {params.workdir}

            echo "[$(date)] Done"
        ) &> {log}
        """

rule classify_hybrid_community:
    """Two-tier RVDB classification: BLASTn all contigs against clustered
    nucleotide RVDB, then BLASTx only the contigs that failed the confident-hit
    threshold against protein RVDB, then annotate both against the RVDB
    nucleotide taxonomy table."""
    input:
        hybrid=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_hybrid.fasta"),
    output:
        nucl_blast=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_blast_nucl.tsv"),
        prot_blast=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_blast_prot.tsv"),
        summary=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_community_summary.tsv"),
        per_contig=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_per_contig_identity.tsv"),
    log:
        str(OUTPUT_ROOT / "logs" / "classify_community" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    params:
        nucl_db=RVDB_NUCL_DB,
        prot_db=RVDB_PROT_DB,
        taxonomy=RVDB_TAXONOMY,
        min_id=RVDB_MIN_IDENTITY,
        min_cov=RVDB_MIN_COVERAGE,
        workdir=lambda wc: str(HYBRID_ROOT / wc.category / wc.unique_id / "community" / "work"),
    threads: 8
    resources:
        mem_mb=8000,
        partition="cmmr",
    shell:
        """
        (
            echo "[$(date)] Tiered RVDB classification for {wildcards.unique_id}"
            mkdir -p {params.workdir}

            # Empty assembly -> write empty outputs and stop
            if [ ! -s {input.hybrid} ]; then
                echo "[$(date)] Empty hybrid assembly, writing empty outputs"
                : > {output.nucl_blast}
                : > {output.prot_blast}
                echo -e "family\tspecies\tnum_contigs\tavg_identity\ttotal_length" > {output.summary}
                echo -e "contig_id\ttier\taccession\tpercent_identity\tquery_coverage\tcontig_length\trealm\tkingdom\tphylum\tclass\torder\tfamily\tgenus\tspecies\tsubspecies" > {output.per_contig}
                exit 0
            fi

            # Tier 1: BLASTn vs clustered nucleotide RVDB
            blastn \
                -query {input.hybrid} \
                -db {params.nucl_db} \
                -outfmt "6 qseqid sseqid pident length qlen slen qcovs evalue bitscore stitle" \
                -max_target_seqs 1 \
                -num_threads {threads} \
                -evalue 1e-10 \
                > {output.nucl_blast}

            # Select contigs that FAILED the confident nucleotide threshold
            python scripts/select_nucl_misses.py \
                --nucl-blast {output.nucl_blast} \
                --hybrid-fasta {input.hybrid} \
                --output-fasta {params.workdir}/misses.fasta \
                --min-identity {params.min_id} \
                --min-coverage {params.min_cov}

            # Tier 2: BLASTx the misses vs protein RVDB
            if [ -s {params.workdir}/misses.fasta ]; then
                blastx \
                    -query {params.workdir}/misses.fasta \
                    -db {params.prot_db} \
                    -outfmt "6 qseqid sseqid pident length qlen slen qcovs evalue bitscore stitle" \
                    -max_target_seqs 1 \
                    -num_threads {threads} \
                    -evalue 1e-5 \
                    > {output.prot_blast}
            else
                echo "[$(date)] No nucleotide misses; skipping protein tier"
                : > {output.prot_blast}
            fi

            # Merge + annotate against taxonomy
            python scripts/annotate_rvdb_tiered.py \
                --nucl-blast {output.nucl_blast} \
                --prot-blast {output.prot_blast} \
                --taxonomy {params.taxonomy} \
                --hybrid-fasta {input.hybrid} \
                --output-summary {output.summary} \
                --output-per-contig {output.per_contig} \
                --min-identity {params.min_id} \
                --min-coverage {params.min_cov}

            echo "[$(date)] Done"
        ) &> {log}
        """

rule final_stats:
    """Generate final assembly statistics with community composition."""
    input:
        hybrid=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_hybrid.fasta"),
        pre_stats=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "stats" / "{unique_id}_pre_merge_stats.txt"),
        merge_decisions=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_merge_decisions.tsv"),
        community_summary=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_community_summary.tsv"),
        per_contig=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_per_contig_identity.tsv"),
    output:
        str(HYBRID_ROOT / "{category}" / "{unique_id}" / "stats" / "{unique_id}_assembly_stats.txt"),
    log:
        str(OUTPUT_ROOT / "logs" / "final_stats" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    run:
        import pandas as pd
        import subprocess

        with open(output[0], 'w') as f:
            f.write("="*80 + "\n")
            f.write(f"FINAL HYBRID ASSEMBLY REPORT: {wildcards.unique_id}\n")
            f.write("="*80 + "\n\n")

            # Pre-merge stats
            f.write("PRE-MERGE ASSEMBLY STATISTICS\n")
            f.write("-"*80 + "\n")
            with open(input.pre_stats, 'r') as pre:
                f.write(pre.read())
            f.write("\n")

            # Hybrid assembly basic stats
            f.write("\nHYBRID ASSEMBLY (READ-SUPPORTED MERGE) STATISTICS\n")
            f.write("-"*80 + "\n")

            # Run seqkit stats
            result = subprocess.run(
                ['seqkit', 'stats', input.hybrid],
                capture_output=True,
                text=True
            )
            f.write(result.stdout)
            f.write("\n")

            # Merge decisions summary
            f.write("\nMERGE DECISIONS SUMMARY\n")
            f.write("-"*80 + "\n")

            try:
                merge_df = pd.read_csv(input.merge_decisions, sep='\t')

                if not merge_df.empty:
                    f.write(f"Total decisions made: {len(merge_df)}\n\n")
                    f.write("Decisions by category:\n")
                    category_counts = merge_df['decision_category'].value_counts()
                    for cat, count in category_counts.items():
                        f.write(f"  {cat}: {count}\n")
                    f.write("\n")

                    # Show some example decisions
                    f.write("Example merge decisions:\n")
                    examples = merge_df[merge_df['decision_category'] != 'singleton'].head(5)
                    for _, row in examples.iterrows():
                        f.write(f"\n  Kept: {row['contig_kept']}\n")
                        f.write(f"  Discarded: {row['contig_discarded']}\n")
                        f.write(f"  Reason: {row['reason']}\n")
                else:
                    f.write("No merge decisions recorded.\n\n")
            except Exception:
                f.write("No merge decision data available.\n\n")

            # Community composition
            f.write("\nCOMMUNITY COMPOSITION (RVDB tiered classification)\n")
            f.write("-"*80 + "\n")

            try:
                community_df = pd.read_csv(input.community_summary, sep='\t')
                if not community_df.empty:
                    f.write(f"Total taxa detected (family/species groups): {len(community_df)}\n\n")
                    f.write(community_df.to_string(index=False))
                    f.write("\n\n")
                else:
                    f.write("No viruses detected in hybrid assembly.\n\n")
            except Exception:
                f.write("No community data available.\n\n")

            # Per-contig identity summary
            f.write("\nPER-CONTIG SUMMARY\n")
            f.write("-"*80 + "\n")

            try:
                per_contig_df = pd.read_csv(input.per_contig, sep='\t')
                if not per_contig_df.empty:
                    # percent_identity / query_coverage can be "NA" for no-hit contigs
                    pid = pd.to_numeric(per_contig_df['percent_identity'], errors='coerce')
                    qcov = pd.to_numeric(per_contig_df['query_coverage'], errors='coerce')
                    n_hits = int(pid.notna().sum())

                    f.write(f"Total contigs: {len(per_contig_df)}\n")
                    f.write(f"Contigs with a database hit: {n_hits}\n")

                    if 'tier' in per_contig_df.columns:
                        f.write("\nContigs by classification tier:\n")
                        for tier, count in per_contig_df['tier'].value_counts().items():
                            f.write(f"  {tier}: {count}\n")

                    if n_hits > 0:
                        f.write(f"\nAverage identity (hits only): {pid.mean():.2f}%\n")
                        f.write(f"Median identity (hits only): {pid.median():.2f}%\n")
                        f.write(f"Min identity: {pid.min():.2f}%\n")
                        f.write(f"Max identity: {pid.max():.2f}%\n")
                        f.write(f"Average coverage (hits only): {qcov.mean():.2f}%\n\n")

                        top = per_contig_df.assign(_pid=pid).nlargest(10, '_pid')[
                            ['contig_id', 'species', 'family', 'tier',
                             'percent_identity', 'query_coverage', 'contig_length']
                        ]
                        f.write("Top 10 contigs by percent identity:\n")
                        f.write(top.to_string(index=False))
                        f.write("\n")
                    else:
                        f.write("\nNo contigs had a database hit.\n")
                else:
                    f.write("No contig data available.\n")
            except Exception:
                f.write("No per-contig data available.\n")

            f.write("\n" + "="*80 + "\n")
