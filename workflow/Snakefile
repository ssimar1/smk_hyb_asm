rule extract_quality_contigs:
    """Extract high-quality contigs based on CheckV results."""
    input:
        fasta=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "filtered" / "metaviral_filtered.fasta"),
        summary=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "checkv" / "quality_summary.tsv"),
    output:
        ids=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "filtered" / "good_contigs.txt"),
        fasta=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "filtered" / "metaviral_clean.fasta"),
    log:
        str(OUTPUT_ROOT / "logs" / "extract_quality" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    params:
        quality_levels=CHECKV_QUALITY,
    run:
        import pandas as pd

        # Read CheckV summary
        df = pd.read_csv(input.summary, sep='\t')

        # Filter by quality
        quality_contigs = df[df['checkv_quality'].isin(params.quality_levels)]['contig_id'].tolist()

        # Write IDs to file
        with open(output.ids, 'w') as f:
            for contig_id in quality_contigs:
                f.write(f"{contig_id}\n")

        # Extract sequences
        shell("seqkit grep -f {output.ids} {input.fasta} > {output.fasta} 2> {log}")


