# =============================================================================
wildcard_constraints:
    unique_id="|".join(UNIQUE_IDS),
    category="sample|control",


# =============================================================================
# Module: Preprocessing - Decompression
# =============================================================================
rule decompress_reads:
    """Decompress forward and reverse reads to temporary directory."""
    input:
        r1=get_r1_input,
        r2=get_r2_input,
    output:
        r1=temp(str(TEMP_ROOT / "{category}" / "01_decompress" / "{unique_id}.R1.fastq")),
        r2=temp(str(TEMP_ROOT / "{category}" / "01_decompress" / "{unique_id}.R2.fastq")),
    log:
        str(OUTPUT_ROOT / "logs" / "01_decompress" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/preprocess.yaml"
    threads: DECOMPRESS_THREADS
    resources:
        mem_mb=DECOMPRESS_MEM_MB,
        runtime=30,
        partition="cmmr",
    params:
        compression=get_compression_type,
    shell:
        """
        (
            echo "[$(date)] Decompressing R1: {input.r1}"
            if [ "{params.compression}" == "gz" ]; then
               timeout 600s  pigz -dc -p {threads} < {input.r1} > {output.r1}
            elif [ "{params.compression}" == "bz2" ]; then
                timeout 600s pbzip2 -d -c -p{threads} < {input.r1} > {output.r1}
            else
                echo "ERROR: Unknown compression type: {params.compression}" >&2
                exit 1
            fi

            echo "[$(date)] Decompressing R2: {input.r2}"
            if [ "{params.compression}" == "gz" ]; then
                timeout 600s pigz -dc -p {threads} < {input.r2} > {output.r2}
            elif [ "{params.compression}" == "bz2" ]; then
                timeout 600s pbzip2 -d -c -p{threads} < {input.r2} > {output.r2}
            else
                echo "ERROR: Unknown compression type: {params.compression}" >&2
                exit 1
            fi

            echo "[$(date)] Done"
        ) &> {log}
        """


# =============================================================================
# Module: Preprocessing - Quality Filtering (fastp)
# =============================================================================
rule fastp_qc:
    """Quality filter reads using fastp."""
    input:
        r1=str(TEMP_ROOT / "{category}" / "01_decompress" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "01_decompress" / "{unique_id}.R2.fastq"),
    output:
        r1=temp(str(TEMP_ROOT / "{category}" / "02_fastp" / "{unique_id}.R1.fastq")),
        r2=temp(str(TEMP_ROOT / "{category}" / "02_fastp" / "{unique_id}.R2.fastq")),
        html=str(OUTPUT_ROOT / "qc" / "fastp" / "{category}" / "{unique_id}.fastp.html"),
        json=str(OUTPUT_ROOT / "qc" / "fastp" / "{category}" / "{unique_id}.fastp.json"),
    log:
        str(OUTPUT_ROOT / "logs" / "02_fastp" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/preprocess.yaml"
    threads: FASTP_THREADS
    resources:
        mem_mb=FASTP_MEM_MB,
        partition="cmmr",
    shell:
        """
        (
            echo "[$(date)] Running fastp for {wildcards.unique_id}"

            fastp \
                --in1 {input.r1} \
                --in2 {input.r2} \
                --out1 {output.r1} \
                --out2 {output.r2} \
                --html {output.html} \
                --json {output.json} \
                --thread {threads}

            echo "[$(date)] Done"
        ) &> {log}
        """


# =============================================================================
# Module: Preprocessing - Deduplication (fastp)
# =============================================================================
rule fastp_dedup:
    """Remove PCR duplicates using fastp."""
    input:
        r1=str(TEMP_ROOT / "{category}" / "02_fastp" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "02_fastp" / "{unique_id}.R2.fastq"),
    output:
        r1=temp(str(TEMP_ROOT / "{category}" / "03_dedup" / "{unique_id}.R1.fastq")),
        r2=temp(str(TEMP_ROOT / "{category}" / "03_dedup" / "{unique_id}.R2.fastq")),
        html=str(OUTPUT_ROOT / "qc" / "fastp_dedup" / "{category}" / "{unique_id}.dedup.html"),
        json=str(OUTPUT_ROOT / "qc" / "fastp_dedup" / "{category}" / "{unique_id}.dedup.json"),
    log:
        str(OUTPUT_ROOT / "logs" / "03_dedup" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/preprocess.yaml"
    threads: FASTP_THREADS
    resources:
        mem_mb=FASTP_MEM_MB,
        partition="cmmr",
    shell:
        """
        (
            echo "[$(date)] Running fastp deduplication for {wildcards.unique_id}"

            fastp \
                --dedup \
                --disable_trim_poly_g \
                --disable_adapter_trimming \
                --disable_quality_filtering \
                --disable_length_filtering \
                --in1 {input.r1} \
                --in2 {input.r2} \
                --out1 {output.r1} \
                --out2 {output.r2} \
                --html {output.html} \
                --json {output.json} \
                --report_title {wildcards.unique_id} \
                --thread {threads}

            echo "[$(date)] Done"
        ) &> {log}
        """

# =============================================================================
# Module: Preprocessing - Vector Read Removal
# =============================================================================
rule vector_read_removal:
    """Remove reads aligning to vector sequences using vrr."""
    input:
        r1=str(TEMP_ROOT / "{category}" / "03_dedup" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "03_dedup" / "{unique_id}.R2.fastq"),
        ref=VECTOR_FASTA,
    output:
        r1=temp(str(TEMP_ROOT / "{category}" / "04_vrr" / "{unique_id}.R1.fastq")),
        r2=temp(str(TEMP_ROOT / "{category}" / "04_vrr" / "{unique_id}.R2.fastq")),
        csv=temp(str(TEMP_ROOT / "{category}" / "04_vrr" / "{unique_id}_primary_alignments.csv")),
    log:
        str(OUTPUT_ROOT / "logs" / "04_vrr" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/preprocess.yaml"
    threads: VRR_THREADS
    resources:
        mem_mb=VRR_MEM_MB,
        partition="cmmr",
    params:
        out_prefix=lambda wc: str(TEMP_ROOT / wc.category / "04_vrr" / wc.unique_id),
    shell:
        """
        (
            echo "[$(date)] Running vector read removal for {wildcards.unique_id}"

            vrr \
                -1 {input.r1} \
                -2 {input.r2} \
                -r {input.ref} \
                -o {params.out_prefix} \
                -t {threads} \
                --nm-threshold 4

            # vrr outputs as <prefix>_R1.fastq and <prefix>_R2.fastq
            # Rename to match expected output pattern (R1/R2 use dot, vrr uses underscore)
            mv {params.out_prefix}_R1.fastq {output.r1}
            mv {params.out_prefix}_R2.fastq {output.r2}
            # CSV is already in correct location (no rename needed)

            echo "[$(date)] Done"
        ) &> {log}
        """

# =============================================================================
# Module: Preprocessing - Human Host Removal
# =============================================================================
rule host_removal:
    """Remove host reads using minimap2"""
    input:
        r1=(str(TEMP_ROOT / "{category}" / "04_vrr" / "{unique_id}.R1.fastq")),
        r2=(str(TEMP_ROOT / "{category}" / "04_vrr" / "{unique_id}.R2.fastq")),
        ref=HOST_FASTA,
    output:
        r1=temp(str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R1.fastq")),
        r2=temp(str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R2.fastq")),
    log:
        str(OUTPUT_ROOT / "logs" / "05_host_removed" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/preprocess.yaml"
    threads: HOST_THREADS
    resources:
        mem_mb=HOST_MEM_MB,
        partition="cmmr",
    shell:
        """
        (
            echo "[$(date)] Running host read removal for {wildcards.unique_id}"

            minimap2 -t {threads} -ax sr -K 500M {input.ref} \
                {input.r1} \
                {input.r2} \
                2>> {log} | \
            samtools view -bS - | \
            samtools sort -n - | \
            samtools fastq -f 12 \
                -1 {output.r1} \
                -2 {output.r2} -

            echo "[$(date)] Done"
        ) &> {log}
        """

# =============================================================================
# Module: Virome Analysis - EsViritu
# =============================================================================
rule esviritu:
    """Run EsViritu for viral detection and profiling."""
    input:
        r1=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R2.fastq"),
    output:
        info=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}.detected_virus.info.tsv"),
        assembly=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}.detected_virus.assembly_summary.tsv"),
        tax_profile=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}.tax_profile.tsv"),
        coverage=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}.virus_coverage_windows.tsv"),
        bam=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}_temp" / "{unique_id}.third.filt.sorted.bam"),
        # New: EsViritu outputs as {unique_id}_final_consensus.fasta
        contigs=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}_final_consensus.fasta") if RUN_PRE_MERGE or RUN_HYBRID else [],
    log:
        str(OUTPUT_ROOT / "logs" / "esviritu" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/esviritu.yaml"
    threads: ESVIRITU_THREADS
    resources:
        mem_mb=ESVIRITU_MEM_MB,
        partition="cmmr",
    params:
        db=ESVIRITU_DB,
        out_dir=lambda wc: str(ESVIRITU_ROOT / wc.category / f"esviritu_{POOL_ID}"),
        sample_name=lambda wc: wc.unique_id,
        temp_dir=lambda wc: str(ESVIRITU_ROOT / wc.category / f"esviritu_{POOL_ID}" / f"{wc.unique_id}_temp"),
    shell:
        """
        (
            echo "[$(date)] Running EsViritu for {wildcards.unique_id}"

            EsViritu \
                -r {input.r1} {input.r2} \
                -s {params.sample_name} \
                -o {params.out_dir} \
                --db {params.db} \
                -q F \
                --keep T \
                -t {threads} || true

            echo "[$(date)] Checking for expected output files..."

            # Create dummy output files if EsViritu didn't produce them
            # (e.g., negative controls or samples with no viral hits)
            if [ ! -f "{output.info}" ]; then
                echo "[$(date)] Creating empty file: {output.info}"
                touch "{output.info}"
            fi
            if [ ! -f "{output.assembly}" ]; then
                echo "[$(date)] Creating empty file: {output.assembly}"
                touch "{output.assembly}"
            fi
            if [ ! -f "{output.tax_profile}" ]; then
                echo "[$(date)] Creating empty file: {output.tax_profile}"
                touch "{output.tax_profile}"
            fi
            if [ ! -f "{output.coverage}" ]; then
                echo "[$(date)] Creating empty file: {output.coverage}"
                touch "{output.coverage}"
            fi
            if [ ! -f "{output.bam}" ]; then
                echo "[$(date)] Creating empty file: {output.bam}"
                touch "{output.bam}"
            fi
            # Compress BAM file and clean up EsViritu temp directory
            echo "[$(date)] Cleaning up EsViritu temp directory..."
            if [ -d "{params.temp_dir}" ]; then
                TEMP_SIZE_BEFORE=$(du -sh "{params.temp_dir}" | cut -f1)
                echo "[$(date)] Temp directory size before cleanup: $TEMP_SIZE_BEFORE"

                # Compress BAM file if it exists and is not empty
                if [ -s "{output.bam}" ]; then
                    # Compress with samtools (creates .bam.gz)
                    samtools view -@ {threads} -b -h "{output.bam}" | \
                        gzip -c > "{output.bam}.gz"

                    # Remove original uncompressed BAM and index
                    rm -f "{output.bam}" "{output.bam}.bai"
                fi

                # Delete all other files in temp directory (keeps only .bam.gz)
                echo "[$(date)] Removing other temp files..."
                find "{params.temp_dir}" -type f \
                    ! -name "*.bam.gz" \
                    -delete
            else
                echo "[$(date)] No temp directory found to clean up"
            fi

            echo "[$(date)] Done"
        ) &> {log}
        """

# =============================================================================
# Module: Virome Analysis - EsViritu Summary
# =============================================================================
rule summarize_esviritu:
    """Summarize all EsViritu runs for a category."""
    input:
        get_esviritu_outputs_for_category,
    output:
        info=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}.detected_virus.info.tsv"),
        assembly=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}.detected_virus.assembly_summary.tsv"),
        tax=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}.tax_profile.tsv"),
        html=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}_EsViritu_project_reactable.html"),
        cov=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}.virus_coverage_windows.tsv"),
    log:
        str(OUTPUT_ROOT / "logs" / "esviritu_summary" / "{category}.log"),
    conda:
        "envs/esviritu.yaml"
    params:
        esv_dir=lambda wc: str(ESVIRITU_ROOT / wc.category / f"esviritu_{POOL_ID}"),
        basename=f"esviritu_{POOL_ID}",
    shell:
        """
        (
            echo "[$(date)] Summarizing EsViritu runs for {wildcards.category}"

            # Run summarize_esv_runs (outputs to current working directory)
            summarize_esv_runs {params.esv_dir} || true

            # Move generated files to the correct directory
            for suffix in .detected_virus.info.tsv .detected_virus.assembly_summary.tsv .tax_profile.tsv _EsViritu_project_reactable.html .virus_coverage_windows.tsv; do
                src="{params.basename}${{suffix}}"
                dest="{params.esv_dir}/{params.basename}${{suffix}}"
                if [ -f "$src" ]; then
                    echo "[$(date)] Moving $src to $dest"
                    mv "$src" "$dest"
                else
                    echo "[$(date)] Creating empty file: $dest"
                    touch "$dest"
                fi
            done

            echo "[$(date)] Done"
        ) &> {log}
        """


