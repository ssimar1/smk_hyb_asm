rule metaviralspades:
    """Run metaviralSPADES for de novo viral assembly."""
    input:
        r1=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R1.fastq"),
        r2=str(TEMP_ROOT / "{category}" / "05_host_removed" / "{unique_id}.R2.fastq"),
    output:
        contigs=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "contigs.fasta"),
        scaffolds=str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "scaffolds.fasta"),
    log:
        str(OUTPUT_ROOT / "logs" / "metaviralspades" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    threads: METAVIRALSPADES_THREADS
    resources:
        mem_mb=METAVIRALSPADES_MEM_MB,
        partition="cmmr",
    params:
        outdir=lambda wc: str(METAVIRALSPADES_ROOT / wc.category / wc.unique_id),
    shell:
        """
        (
            echo "[$(date)] Running metaviralSPADES for {wildcards.unique_id}"

            # SPAdes refuses to run into a non-empty directory. On a rerun,
            # wipe any partial output so we always start clean.
            rm -rf {params.outdir}

            metaviralspades.py \
                -1 {input.r1} \
                -2 {input.r2} \
                -o {params.outdir} \
                -t {threads} \
                -m $(({resources.mem_mb} / 1024)) \
                2>&1

            echo "[$(date)] Done"
        ) &> {log}
        """


