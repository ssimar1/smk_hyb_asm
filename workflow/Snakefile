"""
Snakemake pipeline for hybrid capture virome sequencing analysis.
Decompresses reads, runs EsViritu for viral detection, and optionally runs
metaviralSPADES for hybrid assembly.

Version: 0.2.0
"""

__version__ = "0.2.0"

import os
import sys
from pathlib import Path

import pandas as pd
from snakemake.utils import min_version

min_version("8.0")

shell.prefix("set -eo pipefail; ")


# =============================================================================
# Configuration
# =============================================================================
configfile: "config/config.yaml"

# -----------------------------------------------------------------------------
# Global options from config
# -----------------------------------------------------------------------------
POOL_ID = config["pool_id"]
SAMPLE_SHEET = config["sample_sheet"]
ESVIRITU_DB = config["esviritu_db"]
VECTOR_FASTA = config.get("vector_fasta", "resources/vector_sequences.fasta")
HOST_FASTA = config.get("host_fasta", "/biolib/prod/db/chm13v2phix/chm13v2phix.fa")

OUTPUT_ROOT = Path(config.get("output_root", "results"))
TEMP_ROOT = OUTPUT_ROOT / "temp"
ESVIRITU_ROOT = OUTPUT_ROOT / "esviritu"
VIRUS_READS_ROOT = OUTPUT_ROOT / "virus_reads"

# New: Hybrid assembly output directories
METAVIRALSPADES_ROOT = OUTPUT_ROOT / "metaviralspades"
HYBRID_ROOT = OUTPUT_ROOT / "hybrid_assembly"

DECOMPRESS_THREADS = config.get("decompress_threads", 4)
FASTP_THREADS = config.get("fastp_threads", 8)
VRR_THREADS = config.get("vrr_threads", 4)
HOST_THREADS = config.get("host_threads", 8)
ESVIRITU_THREADS = config.get("esviritu_threads", 4)

DECOMPRESS_MEM_MB = config.get("decompress_mem_mb", 8000)
FASTP_MEM_MB = config.get("fastp_mem_mb", 16000)
VRR_MEM_MB = config.get("vrr_mem_mb", 8000)
HOST_MEM_MB = config.get("host_mem_mb", 8000)
ESVIRITU_MEM_MB = config.get("esviritu_mem_mb", 8000)

# New: Hybrid assembly resource allocation
METAVIRALSPADES_THREADS = config.get("metaviralspades_threads", 16)
METAVIRALSPADES_MEM_MB = config.get("metaviralspades_mem_mb", 64000)
CHECKV_THREADS = config.get("checkv_threads", 16)
CHECKV_MEM_MB = config.get("checkv_mem_mb", 16000)
MERGE_THREADS = config.get("merge_threads", 4)
MERGE_MEM_MB = config.get("merge_mem_mb", 16000)
MERGE_MIN_OVERLAP = config.get("merge_min_overlap", 500)
MERGE_MIN_IDENTITY = config.get("merge_min_identity", 95)

# New: Hybrid assembly parameters
CHECKV_DB = config.get("checkv_db", "/data/prod/db/checkv/v1.5")
MIN_CONTIG_LENGTH = config.get("min_contig_length", 500)
CHECKV_QUALITY = config.get("checkv_quality", ["Complete", "High-quality", "Medium-quality"])

# New: RVDB tiered classification
RVDB_NUCL_DB = config.get("rvdb_nucl_db")
RVDB_PROT_DB = config.get("rvdb_prot_db")
RVDB_TAXONOMY = config.get("rvdb_taxonomy")
RVDB_MIN_IDENTITY = config.get("rvdb_min_identity", 90)
RVDB_MIN_COVERAGE = config.get("rvdb_min_coverage", 50)

# Pipeline stage flags
RUN_QC = config.get("run_qc", True)
RUN_ASSEMBLIES = config.get("run_assemblies", True)
RUN_ESVIRITU = config.get("run_esviritu", True)
RUN_METAVIRALSPADES = config.get("run_metaviralspades", False)
RUN_CHECKV = config.get("run_checkv", False)
RUN_PRE_MERGE = config.get("run_pre_merge", False)
RUN_HYBRID = config.get("run_hybrid", False)


# =============================================================================
# Sample sheet parsing
# =============================================================================
def load_sample_sheet(path):
    """Load and validate sample sheet, returning a DataFrame."""
    df = pd.read_csv(path, sep="\t", dtype=str)
    required_cols = ["Sample_ID", "forward_read", "reverse_read", "read_compression", "category"]
    missing = set(required_cols) - set(df.columns)
    if missing:
        sys.exit(f"[ERROR] Sample sheet missing required columns: {missing}")

    # Because I'm lazy-- instead of changing all the unique id info, just copy sample_id to unique_id in the df (I don't need pool IDs for my data, at least right now)
    df["unique_id"] = df["Sample_ID"]
    return df


SAMPLES = load_sample_sheet(SAMPLE_SHEET)

# Build lookup dictionaries for easy access in rules
SAMPLE_INFO = SAMPLES.set_index("unique_id").to_dict(orient="index")
UNIQUE_IDS = SAMPLES["unique_id"].tolist()
CATEGORIES = SAMPLES["category"].unique().tolist()

sys.stderr.write(f"[INFO] Loaded {len(UNIQUE_IDS)} samples from {SAMPLE_SHEET}\n")


# =============================================================================
# Helper functions
# =============================================================================
def get_sample_attr(wildcards, attr):
    """Get attribute for a sample by unique_id."""
    return SAMPLE_INFO[wildcards.unique_id][attr]


def get_compression_type(wildcards):
    """Return compression type for a sample."""
    return get_sample_attr(wildcards, "read_compression")


def get_r1_input(wildcards):
    """Get forward read path for a sample."""
    return get_sample_attr(wildcards, "forward_read")


def get_r2_input(wildcards):
    """Get reverse read path for a sample."""
    return get_sample_attr(wildcards, "reverse_read")


def get_category(wildcards):
    """Get category for a sample."""
    return get_sample_attr(wildcards, "category")


def get_esviritu_outputs_for_category(wildcards):
    """Get all EsViritu info.tsv outputs for a given category."""
    category_samples = SAMPLES[SAMPLES["category"] == wildcards.category]["unique_id"].tolist()
    return expand(
        str(ESVIRITU_ROOT / wildcards.category / f"esviritu_{POOL_ID}" / "{unique_id}.detected_virus.info.tsv"),
        unique_id=category_samples,
    )


def get_all_inputs(wildcards):
    """Build list of target files based on pipeline stage flags."""
    inputs = []

    if RUN_ESVIRITU:
        # EsViritu outputs
        inputs.extend(expand(
            str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}.detected_virus.info.tsv"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        # EsViritu summary per category
        inputs.extend(expand(
            str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / f"esviritu_{POOL_ID}.detected_virus.info.tsv"),
            category=CATEGORIES,
        ))

    if RUN_METAVIRALSPADES:
        # metaviralSPADES outputs
        inputs.extend(expand(
            str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "contigs.fasta"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))

    if RUN_CHECKV:
        # CheckV outputs
        inputs.extend(expand(
            str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "checkv" / "quality_summary.tsv"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        inputs.extend(expand(
            str(METAVIRALSPADES_ROOT / "{category}" / "{unique_id}" / "filtered" / "metaviral_clean.fasta"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))

    if RUN_PRE_MERGE:
        # Renamed contigs and pre-merge stats
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "metaviral_renamed.fasta"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "esviritu_renamed.fasta"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "stats" / "{unique_id}_pre_merge_stats.txt"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))

    if RUN_HYBRID:
        # Hybrid assembly outputs
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_hybrid.fasta"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        # Merge decision reports
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "hybrid" / "{unique_id}_merge_decisions.tsv"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "stats" / "{unique_id}_assembly_stats.txt"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        # Community classification outputs
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_community_summary.tsv"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))
        inputs.extend(expand(
            str(HYBRID_ROOT / "{category}" / "{unique_id}" / "community" / "{unique_id}_per_contig_identity.tsv"),
            zip,
            unique_id=UNIQUE_IDS,
            category=SAMPLES["category"].tolist(),
        ))

    return inputs


# =============================================================================
# Target rules
# =============================================================================
rule all:
    input:
        get_all_inputs


