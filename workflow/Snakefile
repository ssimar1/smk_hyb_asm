            seqkit replace -p '(.+)' -r 'metaviral_{{nr}}' {input} > {output}
            echo "[$(date)] Done"
        ) &> {log}
        """

rule rename_esviritu_with_segments:
    """Rename EsViritu contigs with virus and segment information from database metadata."""
    input:
        fasta=str(ESVIRITU_ROOT / "{category}" / f"esviritu_{POOL_ID}" / "{unique_id}_final_consensus.fasta"),
    output:
        str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "esviritu_renamed.fasta"),
    log:
        str(OUTPUT_ROOT / "logs" / "rename_esviritu" / "{category}" / "{unique_id}.log"),
    conda:
        "envs/hyb_asm.yaml"
    params:
        db_dir=ESVIRITU_DB,
    run:
        import pandas as pd
        from Bio import SeqIO
        from Bio.SeqRecord import SeqRecord
        import re
        from pathlib import Path

        # Read metadata from EsViritu database
        metadata_file = Path(params.db_dir) / "virus_pathogen_database.all_metadata.tsv"
        metadata = pd.read_csv(metadata_file, sep='\t')

        # Create accession to metadata mapping
        acc_to_info = {}
        for _, row in metadata.iterrows():
            acc = row['Accession']

            # Get subspecies (more specific than species name)
            subspecies = row.get('subspecies', '')
            if pd.notna(subspecies) and subspecies != '""' and subspecies != '':
                virus_name = subspecies.replace('t__', '').strip()
            else:
                virus_name = row.get('Name', 'Unknown').strip()

            # Clean virus name for use in ID
            virus_name_clean = virus_name.replace(' ', '_')

            # Get segment
            segment = row.get('Segment', '')
            if pd.notna(segment) and segment != '""' and segment != '':
                segment = str(segment).strip()
            else:
                segment = None

            acc_to_info[acc] = {
                'virus_name': virus_name_clean,
                'segment': segment,
            }

        # Rename sequences
        output_records = []

        for record in SeqIO.parse(input.fasta, 'fasta'):
            # Extract accession from header like "KC731482.1_consensus"
            match = re.match(r'^([A-Z0-9_]+\.\d+)', record.id)

            if match:
                acc = match.group(1)

                if acc in acc_to_info:
                    info = acc_to_info[acc]

                    # Build new ID
                    if info['segment']:
                        new_id = f"esviritu_{info['virus_name']}_seg{info['segment']}_{acc}"
                    else:
                        new_id = f"esviritu_{info['virus_name']}_{acc}"
                else:
                    # Accession not in metadata (shouldn't happen)
                    new_id = f"esviritu_{record.id}"
            else:
                # Couldn't parse accession
                new_id = f"esviritu_{record.id}"

            new_record = SeqRecord(
                record.seq,
                id=new_id,
                description=""
            )
            output_records.append(new_record)

        # Write output
        if output_records:
            SeqIO.write(output_records, output[0], 'fasta')
            with open(log[0], 'w') as logfile:
                logfile.write(f"Renamed {len(output_records)} EsViritu contigs\n")
        else:
            # Create empty file
            open(output[0], 'w').close()
            with open(log[0], 'w') as logfile:
                logfile.write(f"Warning: No EsViritu contigs to rename\n")


rule pre_merge_stats:
    """Generate assembly statistics before merging."""
    input:
        metaviral=str(HYBRID_ROOT / "{category}" / "{unique_id}" / "renamed" / "metaviral_renamed.fasta"),
